generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          Int      @id @default(autoincrement())
  category    String
  title       String
  description String
  price       Int?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// One row (id = 1) holding everything the admin can edit from the dashboard.
model SiteSettings {
  id           Int      @id @default(1)
  contactEmail String? // where contact-form messages are emailed
  etsyUrl      String?
  teachingUrl  String?
  cv           Json? // CV builder data
  updatedAt    DateTime @updatedAt
}
