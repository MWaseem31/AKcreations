DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Admin login (you choose these)
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=a-long-strong-password
AUTH_SECRET=run: openssl rand -base64 32

# Chat assistant (Pollinations)
POLLINATIONS_API_KEY=sk_...
POLLINATIONS_MODEL=deepseek

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Email sending (nodemailer). The RECEIVING address is set in the admin dashboard;
# DEVELOPER_EMAIL is only a fallback until you set one there.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=you@yourdomain.com
DEVELOPER_EMAIL=you@example.com
CRON_SECRET=any-long-random-string
